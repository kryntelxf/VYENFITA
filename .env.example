# Rename this to .env

# Sentry
APPSMITH_SENTRY_DSN=

# Smart look
APPSMITH_SMART_LOOK_ID=

# Google OAuth
APPSMITH_OAUTH2_GOOGLE_CLIENT_ID=
APPSMITH_OAUTH2_GOOGLE_CLIENT_SECRET=

# Github OAuth
APPSMITH_OAUTH2_GITHUB_CLIENT_ID=
APPSMITH_OAUTH2_GITHUB_CLIENT_SECRET=

# Form Login/Signup
APPSMITH_FORM_LOGIN_DISABLED=
APPSMITH_SIGNUP_DISABLED=

# Segment
APPSMITH_SEGMENT_KEY=

#Client log level (debug | error)
APPSMITH_CLIENT_LOG_LEVEL=

# Email server
APPSMITH_MAIL_ENABLED=
APPSMITH_MAIL_HOST=
APPSMITH_MAIL_PORT=
APPSMITH_MAIL_USERNAME=
APPSMITH_MAIL_PASSWORD=

# Email server feature toggles
# true | false values
APPSMITH_MAIL_SMTP_AUTH=
APPSMITH_MAIL_SMTP_TLS_ENABLED=

# Disable all telemetry
# Note: This only takes effect in self-hosted scenarios.
# Please visit https://docs.appsmith.com/product/telemetry to read more about anonymized data collected by Appsmith
# APPSMITH_DISABLE_TELEMETRY=false

#APPSMITH_SENTRY_DSN=
#APPSMITH_SENTRY_ENVIRONMENT=

# Configure cloud services
# APPSMITH_CLOUD_SERVICES_BASE_URL="https://release-cs.appsmith.com"

# Google Recaptcha Config
APPSMITH_RECAPTCHA_SITE_KEY=
APPSMITH_RECAPTCHA_SECRET_KEY=
APPSMITH_RECAPTCHA_ENABLED=

# Pylon in-app chat (optional runtime override; prefer REACT_APP_PYLON_APP_ID at build)
# Chat identity verification (email_hash) is computed by Appsmith Cloud Services; no
# local identity secret is required.
APPSMITH_PYLON_APP_ID=
APPSMITH_DISABLE_PYLON=

# ============================================================
# VYENFITA CONFIGURATION
# ============================================================
# Added by VYENFITA — AI-native business application platform
#
# These variables configure the VYENFITA AI service and its
# integration with Appsmith. All values are optional; sensible
# defaults are applied by docker-compose.override.yml.
#
# For the full list of AI-service-only variables, see:
#   app/ai/.env.example
# ============================================================

# -------------------- DATABASE (Neon PostgreSQL) --------------------
# Required for the AI service to persist data.
# Get your connection string from: https://console.neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# -------------------- JWT & SESSION --------------------
# Generate JWT_SECRET with: openssl rand -base64 48
# Minimum 32 characters required.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# -------------------- ENCRYPTION --------------------
# Generate ENCRYPTION_KEY with: openssl rand -base64 32
# Used for encrypting secrets stored in the database (AES-256-GCM).
ENCRYPTION_KEY=

# -------------------- VYENFITA AI SERVICE --------------------
VYENFITA_AI_PORT=3001
VYENFITA_AI_HOST=0.0.0.0

# -------------------- AI PROVIDERS --------------------
# At least one provider must be configured for AI features to work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000

# Default provider: openai | anthropic
AI_PROVIDER=openai

# -------------------- AI SERVICE AUTH --------------------
# Comma-separated API keys for the AI service.
AI_API_KEYS=vyenfita-default-key

# -------------------- AI SERVICE BEHAVIOR --------------------
AI_LOG_LEVEL=info
AI_ENABLE_CACHING=true
AI_CACHE_TTL=3600
AI_CACHE_MAX_ITEMS=10000

# -------------------- RATE LIMITING --------------------
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX_REQUESTS=1000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_SKIP_SUCCESSFUL=false

# -------------------- RETRY & CIRCUIT BREAKER --------------------
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=1000
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_TIMEOUT_MS=30000

# -------------------- CONCURRENCY --------------------
AI_MAX_CONCURRENT_REQUESTS=50
AI_REQUEST_TIMEOUT_MS=30000

# -------------------- SCHEDULER --------------------
# Enable/disable the cron scheduler for workflow triggers.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=30000

# -------------------- SECURITY --------------------
NODE_ENV=production
BCRYPT_ROUNDS=12
AUDIT_RETENTION_DAYS=90

# -------------------- OBSERVABILITY --------------------
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090
SERVICE_VERSION=3.0.0
AI_ENABLE_METRICS=true
AI_METRICS_PORT=9090
AI_ENABLE_AUDIT_LOGS=true
AI_LOG_FILE_PATH=/app/logs/ai-service.log

# -------------------- FEATURE FLAGS --------------------
AI_ENABLE_APPLICATION_GENERATION=true
AI_ENABLE_WORKFLOW_GENERATION=true
AI_ENABLE_AUTOMATION=true

# -------------------- APPSMITH INTEGRATION --------------------
APPSMITH_AI_ENABLED=true
APPSMITH_AI_SERVICE_URL=http://vyenfita-ai:3001
APPSMITH_AI_API_KEY=vyenfita-default-key
APPSMITH_AI_TIMEOUT=30000
APPSMITH_AI_DEFAULT_PROVIDER=openai
APPSMITH_AI_HEALTH_CHECK_INTERVAL=60
APPSMITH_AI_RETRY_ATTEMPTS=3
APPSMITH_AI_RETRY_BACKOFF_MS=1000
APPSMITH_FEATURE_AI_APPLICATION_GENERATION=true
APPSMITH_FEATURE_AI_WORKFLOW_GENERATION=true

# ============================================================
# DEPLOYMENT TARGETS
# ============================================================
# Configure one or more deployment drivers. Each driver
# auto-registers at startup only if its required env vars
# are present. Docker is always available.
# ============================================================

# -------------------- DOCKER (always available) --------------------
DOCKER_NETWORK=vyenfita-deployments
ARTIFACTS_DIR=/tmp/vyenfita-artifacts
RUNTIME_IMAGE=node:24.14.1-alpine
DOCKER_REGISTRY=

# -------------------- KUBERNETES --------------------
# Set K8S_NAMESPACE (and optionally KUBECONFIG_BASE64) to enable.
# If running inside a cluster, in-cluster auth is used automatically.
K8S_NAMESPACE=
KUBECONFIG_BASE64=

# -------------------- AWS ECS (Fargate) --------------------
# Set AWS_ACCESS_KEY_ID + AWS_ECS_CLUSTER to enable.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ECS_CLUSTER=
AWS_SUBNETS=
AWS_SECURITY_GROUPS=
AWS_EXECUTION_ROLE_ARN=
AWS_TASK_ROLE_ARN=
AWS_LOG_GROUP=

# -------------------- GCP CLOUD RUN --------------------
# Set GCP_PROJECT_ID to enable.
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_BASE64=
GCP_ACCESS_TOKEN=

# -------------------- VERCEL --------------------
# Set VERCEL_TOKEN to enable.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_NAME=
