# ============================================================
# VYENFITA PRODUCTION ENVIRONMENT
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# MongoDB
APPSMITH_DB_URL=mongodb://admin:admin123@mongodb:27017/appsmith

# Redis
APPSMITH_REDIS_HOST=redis
APPSMITH_REDIS_PORT=6379
APPSMITH_REDIS_PASSWORD=your-redis-password

# Database Credentials (for init)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
REDIS_PASSWORD=your-redis-password

# ============================================================
# ENCRYPTION & SECURITY
# ============================================================

APPSMITH_ENCRYPTION_PASSWORD=your-strong-encryption-password-here
APPSMITH_ENCRYPTION_SALT=your-encryption-salt-here

# JWT
APPSMITH_JWT_SECRET=your-jwt-secret-here
APPSMITH_JWT_EXPIRY=86400000
APPSMITH_JWT_REFRESH_EXPIRY=604800000

# ============================================================
# AI PROVIDERS
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini (optional)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# ============================================================
# AI SERVICE
# ============================================================

AI_PROVIDER=openai
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

AI_SERVICE_PORT=3001
AI_SERVICE_HOST=0.0.0.0
AI_API_KEYS=prod-key-1,prod-key-2,prod-key-3

AI_LOG_LEVEL=warn
AI_ENABLE_CACHING=true
AI_CACHE_TTL=3600
AI_CACHE_MAX_ITEMS=10000

AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX_REQUESTS=1000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_SKIP_SUCCESSFUL=false

AI_MAX_CONCURRENT_REQUESTS=50
AI_REQUEST_TIMEOUT_MS=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=1000

AI_ENABLE_METRICS=true
AI_METRICS_PORT=9090
AI_ENABLE_HEALTH_CHECK=true

AI_ENABLE_APPLICATION_GENERATION=true
AI_ENABLE_WORKFLOW_GENERATION=true
AI_ENABLE_ANALYTICS=true
AI_ENABLE_AUTOMATION=true
AI_ENABLE_DEBUGGING=false

AI_ENABLE_AUDIT_LOGS=true
AI_LOG_FILE_PATH=/var/log/vyenfita/ai.log

# ============================================================
# APPSMITH AI INTEGRATION
# ============================================================

APPSMITH_AI_ENABLED=true
APPSMITH_AI_SERVICE_URL=http://vyenfita-ai:3001
APPSMITH_AI_API_KEY=prod-key-1
APPSMITH_AI_TIMEOUT=30000
APPSMITH_AI_DEFAULT_PROVIDER=openai

APPSMITH_AI_HEALTH_CHECK_INTERVAL=60
APPSMITH_AI_HEALTH_CHECK_TIMEOUT=5
APPSMITH_AI_RETRY_ATTEMPTS=3
APPSMITH_AI_RETRY_BACKOFF_MS=1000
APPSMITH_AI_CIRCUIT_BREAKER_ENABLED=true
APPSMITH_AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
APPSMITH_AI_CIRCUIT_BREAKER_TIMEOUT_MS=30000

APPSMITH_FEATURE_AI_APPLICATION_GENERATION=true
APPSMITH_FEATURE_AI_WORKFLOW_GENERATION=true
APPSMITH_FEATURE_AI_AUTOMATION=true
APPSMITH_FEATURE_AI_ANALYTICS=true

# ============================================================
# ENTERPRISE FEATURES
# ============================================================

APPSMITH_TENANT_ENABLED=true
APPSMITH_TENANT_DEFAULT=default

APPSMITH_FEATURE_SSO=false
APPSMITH_FEATURE_AUDIT_LOGS=false
APPSMITH_FEATURE_ADVANCED_RBAC=false
APPSMITH_FEATURE_AI_PREMIUM=false
APPSMITH_FEATURE_UNLIMITED_WORKSPACES=false

APPSMITH_ENTERPRISE_ENABLED=false
APPSMITH_ENTERPRISE_LICENSE_KEY=

APPSMITH_COMMERCIAL_PLAN=community
APPSMITH_COMMERCIAL_MAX_USERS=5
APPSMITH_COMMERCIAL_MAX_APPS=10
APPSMITH_COMMERCIAL_MAX_WORKSPACES=1

# ============================================================
# MAIL CONFIGURATION (Optional)
# ============================================================

APPSMITH_MAIL_ENABLED=false
APPSMITH_MAIL_HOST=smtp.sendgrid.net
APPSMITH_MAIL_PORT=587
APPSMITH_MAIL_USERNAME=
APPSMITH_MAIL_PASSWORD=
APPSMITH_MAIL_FROM=admin@appsmith.com
APPSMITH_MAIL_TLS=true

# ============================================================
# GIT STORAGE
# ============================================================

APPSMITH_GIT_ROOT=/git-storage
APPSMITH_GIT_SSH_PRIVATE_KEY=
APPSMITH_GIT_SSH_PUBLIC_KEY=

# ============================================================
# CORS & SECURITY
# ============================================================

APPSMITH_CORS_ALLOWED_ORIGINS=*
APPSMITH_CSRF_ENABLED=false
APPSMITH_COOKIE_SECURE=true

# ============================================================
# RATE LIMITING
# ============================================================

APPSMITH_RATE_LIMIT_ENABLED=true
APPSMITH_RATE_LIMIT_MAX_REQUESTS=1000
APPSMITH_RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# BRANDING
# ============================================================

APPSMITH_BRANDING_NAME=VYENFITA
APPSMITH_BRANDING_LOGO=/images/vyenfita-logo.png
APPSMITH_BRANDING_FAVICON=/images/vyenfita-favicon.ico
APPSMITH_BRANDING_COPYRIGHT=VYENFITA Team
APPSMITH_BRANDING_URL=https://github.com/kryntelxf/VYENFITA

# ============================================================
# MONITORING
# ============================================================

APPSMITH_METRICS_ENABLED=false
APPSMITH_LOG_LEVEL=INFO
APPSMITH_SEGMENT_ENABLED=false

# ============================================================
# CLOUD SERVICES (Optional)
# ============================================================

APPSMITH_CLOUD_SERVICES_BASE_URL=http://localhost:8080
APPSMITH_CLOUD_SERVICES_API_KEY=

# ============================================================
# DEFAULT ADMIN (First Run)
# ============================================================

APPSMITH_DEFAULT_ADMIN_EMAIL=admin@vyenfita.com
APPSMITH_DEFAULT_ADMIN_PASSWORD=admin123

# ============================================================
# SSL CONFIGURATION (Optional)
# ============================================================

# APPSMITH_SSL_ENABLED=false
# APPSMITH_SSL_KEYSTORE=
# APPSMITH_SSL_KEYSTORE_PASSWORD=
# APPSMITH_SSL_KEYSTORE_TYPE=PKCS12

# ============================================================
# DEVELOPMENT (Production = false)
# ============================================================

APPSMITH_DEVELOPMENT_ENABLED=false
APPSMITH_DEVELOPMENT_ALLOW_UNSAFE_ORIGINS=false
