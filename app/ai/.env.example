# ============================================================
# VYENFITA AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=20&pool_timeout=20
DATABASE_URL="postgresql://vyenfita:vyenfita@localhost:5432/vyenfita?schema=public&connection_limit=20&pool_timeout=20"

# ============================================================
# AI PROVIDERS
# ============================================================

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# ============================================================
# JWT & SESSION
# ============================================================
# IMPORTANT: Change these to secure random strings in production
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# AI SERVICE
# ============================================================
AI_PROVIDER=openai
AI_SERVICE_PORT=3001
AI_SERVICE_HOST=0.0.0.0

# API Keys for authenticating requests to AI Service
# Comma-separated list
AI_API_KEYS=dev-key-1,dev-key-2

# Logging
AI_LOG_LEVEL=info
AI_LOG_FILE_PATH=logs/ai-service.log

# Caching
AI_ENABLE_CACHING=true
AI_CACHE_TTL=3600
AI_CACHE_MAX_ITEMS=10000

# Rate Limiting
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX_REQUESTS=1000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_SKIP_SUCCESSFUL=false

# Performance
AI_MAX_CONCURRENT_REQUESTS=50
AI_REQUEST_TIMEOUT_MS=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=1000

# ============================================================
# SECURITY
# ============================================================
NODE_ENV=development

# Bcrypt rounds for password hashing
# Recommended: 10 (development), 12 (production)
BCRYPT_ROUNDS=10

# Encryption key for sensitive data
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_32_BYTE_KEY

# Session
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# MULTI-TENANCY
# ============================================================
TENANT_ENABLED=true
TENANT_DEFAULT=default

# ============================================================
# OBSERVABILITY
# ============================================================
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
TRACING_ENDPOINT=http://localhost:4318

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_APPLICATION_GENERATION=true
FEATURE_WORKFLOW_GENERATION=true
FEATURE_ANALYTICS=true
FEATURE_AUTOMATION=true
FEATURE_DEBUGGING=false
FEATURE_MARKETPLACE=true
FEATURE_WEBHOOKS=true
FEATURE_PLUGINS=true

# ============================================================
# ENTERPRISE FEATURES
# ============================================================
FEATURE_SSO=false
FEATURE_AUDIT_LOGS=true
FEATURE_ADVANCED_RBAC=true
FEATURE_AI_PREMIUM=false
FEATURE_UNLIMITED_WORKSPACES=false

ENTERPRISE_ENABLED=false
ENTERPRISE_LICENSE_KEY=

# ============================================================
# APPSMITH INTEGRATION
# ============================================================
APPSMITH_API_URL=http://localhost:8080
APPSMITH_API_KEY=your-appsmith-api-key-here
APPSMITH_AI_ENABLED=true
APPSMITH_AI_SERVICE_URL=http://localhost:3001
APPSMITH_AI_TIMEOUT=30000
APPSMITH_AI_DEFAULT_PROVIDER=openai

# ============================================================
# BILLING & COST
# ============================================================
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cost limits (in cents)
COST_LIMIT_FREE=1000
COST_LIMIT_PRO=10000
COST_LIMIT_BUSINESS=100000
COST_LIMIT_ENTERPRISE=-1

# ============================================================
# NOTIFICATIONS
# ============================================================
# Email
EMAIL_ENABLED=false
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@vyenfita.com
EMAIL_TLS=true

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# ============================================================
# DEPLOYMENT
# ============================================================
DEPLOYMENT_ENABLED=false
DEPLOYMENT_PLATFORM=docker
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Kubernetes
KUBERNETES_ENABLED=false
KUBERNETES_CONFIG_PATH=

# ============================================================
# BACKUP
# ============================================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ============================================================
# COMPLIANCE
# ============================================================
COMPLIANCE_ENABLED=false
DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=90
