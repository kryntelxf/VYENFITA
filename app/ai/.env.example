# ============================================
# VYENFITA AI - Environment Configuration
# ============================================

# --------------------------------------------
# OpenAI Configuration
# --------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000
OPENAI_BASE_URL=https://api.openai.com/v1

# --------------------------------------------
# Anthropic Configuration
# --------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --------------------------------------------
# Google Gemini Configuration (Optional)
# --------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# --------------------------------------------
# General AI Configuration
# --------------------------------------------
AI_PROVIDER=openai
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# --------------------------------------------
# VYENFITA AI Service
# --------------------------------------------
AI_SERVICE_PORT=3001
AI_SERVICE_HOST=0.0.0.0
AI_ENABLE_CACHING=true
AI_CACHE_TTL=3600
AI_CACHE_MAX_ITEMS=1000

# --------------------------------------------
# Security
# --------------------------------------------
AI_API_KEYS=your-api-key-1,your-api-key-2
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_SKIP_SUCCESSFUL=false

# --------------------------------------------
# Logging
# --------------------------------------------
AI_LOG_LEVEL=info
AI_ENABLE_AUDIT_LOGS=true
AI_LOG_FILE_PATH=/var/log/vyenfita/ai.log

# --------------------------------------------
# Integration with Appsmith
# --------------------------------------------
APPSMITH_API_URL=http://localhost:8080/api/v1
APPSMITH_API_KEY=your-appsmith-api-key-here

# --------------------------------------------
# Feature Flags
# --------------------------------------------
AI_ENABLE_APPLICATION_GENERATION=true
AI_ENABLE_WORKFLOW_GENERATION=true
AI_ENABLE_ANALYTICS=true
AI_ENABLE_AUTOMATION=true
AI_ENABLE_DEBUGGING=true

# --------------------------------------------
# Performance
# --------------------------------------------
AI_MAX_CONCURRENT_REQUESTS=10
AI_REQUEST_TIMEOUT_MS=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=1000

# --------------------------------------------
# Monitoring
# --------------------------------------------
AI_ENABLE_METRICS=true
AI_METRICS_PORT=9090
AI_ENABLE_HEALTH_CHECK=true
