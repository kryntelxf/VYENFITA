# ============================================================
# VYENFITA AI - Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# ============================================================

# ============================================================
# DATABASE (Neon PostgreSQL)
# ============================================================
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# JWT & SESSION
# ============================================================
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# ENCRYPTION
# ============================================================
# Generate with: openssl rand -base64 32
# Used for encrypting secrets & integration tokens (AES-256-GCM)
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_32_CHARACTER_KEY

# ============================================================
# AI PROVIDERS
# ============================================================
# At least one provider must be configured
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================================
# AI SERVICE
# ============================================================
AI_PROVIDER=openai
AI_SERVICE_PORT=3001
AI_SERVICE_HOST=0.0.0.0
AI_API_KEYS=dev-key-1,dev-key-2
AI_LOG_LEVEL=info
AI_ENABLE_CACHING=true
AI_CACHE_TTL=3600
AI_CACHE_MAX_ITEMS=10000
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX_REQUESTS=1000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_SKIP_SUCCESSFUL=false
AI_MAX_CONCURRENT_REQUESTS=50
AI_REQUEST_TIMEOUT_MS=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=1000

# Circuit breaker
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_TIMEOUT_MS=30000

# ============================================================
# WORKFLOW SCHEDULER
# ============================================================
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=30000

# ============================================================
# SECURITY
# ============================================================
NODE_ENV=development
BCRYPT_ROUNDS=12
AUDIT_RETENTION_DAYS=90

# ============================================================
# OBSERVABILITY
# ============================================================
LOG_LEVEL=info
LOG_FILE=
ENABLE_METRICS=true
METRICS_PORT=9090
SERVICE_VERSION=3.0.0

# ============================================================
# CORS
# ============================================================
APPSMITH_API_URL=http://localhost:8080

# ============================================================
# DEPLOYMENT
# ============================================================
DOCKER_NETWORK=vyenfita-deployments
ARTIFACTS_DIR=/tmp/vyenfita-artifacts
RUNTIME_IMAGE=node:24.14.1-alpine
DOCKER_REGISTRY=

# ============================================================
# KUBERNETES
# ============================================================
K8S_NAMESPACE=vyenfita
KUBECONFIG_BASE64=

# ============================================================
# AWS (for ECS deployment + DR)
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ECS_CLUSTER=
AWS_SUBNETS=
AWS_SECURITY_GROUPS=
AWS_EXECUTION_ROLE_ARN=
AWS_TASK_ROLE_ARN=
AWS_LOG_GROUP=

# ============================================================
# GCP (for Cloud Run)
# ============================================================
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_BASE64=
GCP_ACCESS_TOKEN=

# ============================================================
# VERCEL
# ============================================================
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_NAME=

# ============================================================
# ENTERPRISE INTEGRATIONS - OAuth2 Credentials
# ============================================================
# Each integration requires OAuth2 app credentials
# Register apps at the respective developer portals

# -------------------- Salesforce --------------------
# https://help.salesforce.com/s/articleView?id=sf.remoteaccess_oauth_web_server_flow.htm
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/salesforce/callback

# -------------------- HubSpot --------------------
# https://developers.hubspot.com/docs/api/oauth-quickstart-guide
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3001/api/v1/integrations/hubspot/callback

# -------------------- Slack --------------------
# https://api.slack.com/authentication/oauth-v2
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/v1/integrations/slack/callback

# -------------------- Jira (Atlassian) --------------------
# https://developer.atlassian.com/cloud/jira/platform/oauth-2-3lo-apps/
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3001/api/v1/integrations/jira/callback
