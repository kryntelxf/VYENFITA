# ============================================================
# VYENFITA AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# 
# IMPORTANT: Never commit the actual .env file with real secrets.
# ============================================================

# ============================================================
# DATABASE (Neon PostgreSQL / Self-Hosted PostgreSQL)
# ============================================================
# Get your connection string from: https://console.neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# JWT & SESSION
# ============================================================
# Generate JWT_SECRET with: openssl rand -base64 48
# Minimum 32 characters. NEVER use the default value in production.
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# ENCRYPTION
# ============================================================
# Used to encrypt secrets at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Minimum 32 characters. NEVER use the default value in production.
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_32_BYTE_KEY

# ============================================================
# AI PROVIDERS
# ============================================================
# At least one provider must be configured.

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================================
# AI SERVICE
# ============================================================
AI_PROVIDER=openai
AI_SERVICE_PORT=3001
AI_SERVICE_HOST=0.0.0.0
AI_API_KEYS=dev-key-1,dev-key-2

# Logging
AI_LOG_LEVEL=info
AI_LOG_FILE_PATH=ai-service.log

# Caching
AI_ENABLE_CACHING=true
AI_CACHE_TTL=3600
AI_CACHE_MAX_ITEMS=10000

# Rate limiting
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX_REQUESTS=1000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_SKIP_SUCCESSFUL=false

# Retry & circuit breaker
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=1000
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_TIMEOUT_MS=30000

# Request limits
AI_MAX_CONCURRENT_REQUESTS=10
AI_REQUEST_TIMEOUT_MS=30000

# Feature flags
AI_ENABLE_APPLICATION_GENERATION=true
AI_ENABLE_WORKFLOW_GENERATION=true
AI_ENABLE_AUTOMATION=true
AI_ENABLE_AUDIT_LOGS=true

# ============================================================
# OBSERVABILITY
# ============================================================
ENABLE_METRICS=true
METRICS_PORT=9090
SERVICE_VERSION=3.0.0

# ============================================================
# SECURITY
# ============================================================
NODE_ENV=development
BCRYPT_ROUNDS=12
AUDIT_RETENTION_DAYS=90

# ============================================================
# CORS
# ============================================================
APPSMITH_API_URL=http://localhost:8080

# ============================================================
# SCHEDULER (Phase 11 - Workflow Triggers)
# ============================================================
# Enable/disable the cron scheduler that fires schedule triggers.
SCHEDULER_ENABLED=true

# How often the scheduler polls for due triggers (milliseconds).
# Default: 30000 (30 seconds).
SCHEDULER_POLL_INTERVAL_MS=30000

# ============================================================
# DEPLOYMENT (Phase 5 - Deployment Engine)
# ============================================================
# Docker network for deployments.
DOCKER_NETWORK=vyenfita-deployments

# Runtime image used for deployed applications.
RUNTIME_IMAGE=node:24.14.1-alpine

# Directory where build artifacts are stored.
ARTIFACTS_DIR=/tmp/vyenfita-artifacts

# ============================================================
# TEST DATABASE (Optional — for local test runs)
# ============================================================
# Set this to a separate test database if you run tests locally.
# If not set, tests will use DATABASE_URL.
# TEST_DATABASE_URL=postgresql://test:test@localhost:5432/vyenfita_test
