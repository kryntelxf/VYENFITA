// ============================================================
// VYENFITA DATABASE SCHEMA
// ============================================================
// Production-grade schema for multi-tenant AI-native platform
// 
// @version 3.0.0
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY & MULTI-TENANCY
// ============================================================

/// Tenant (Organization) - root of multi-tenancy
model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(63)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  plan        String   @default("free") @db.VarChar(50)
  status      String   @default("active") @db.VarChar(50)
  settings    Json     @default("{}")
  metadata    Json     @default("{}")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  // Relations
  memberships         Membership[]
  applications        Application[]
  workflows           Workflow[]
  auditEvents         AuditEvent[]
  usageRecords        UsageRecord[]
  costRecords         CostRecord[]
  deployments         Deployment[]
  secrets             Secret[]
  budgets             Budget[]
  marketplaceInstalls MarketplaceInstall[]
  marketplaceReviews  MarketplaceReview[]
  
  @@index([slug])
  @@index([status])
  @@map("tenants")
}

/// User - global identity (belongs to tenants via Membership)
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  name          String?   @db.VarChar(255)
  avatarUrl     String?   @map("avatar_url") @db.Text
  emailVerified Boolean   @default(false) @map("email_verified")
  status        String    @default("active") @db.VarChar(50)
  
  ssoProvider   String?   @map("sso_provider") @db.VarChar(50)
  ssoProviderId String?   @map("sso_provider_id") @db.VarChar(255)
  
  preferredLanguage String @default("en") @map("preferred_language") @db.VarChar(10)
  timezone          String @default("UTC") @db.VarChar(50)
  
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  
  // Relations
  memberships   Membership[]
  sessions      Session[]
  auditEvents   AuditEvent[]
  activityLogs  ActivityLog[]
  
  @@index([email])
  @@index([status])
  @@index([ssoProvider, ssoProviderId])
  @@map("users")
}

/// Membership - links User to Tenant with role
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  status    String   @default("active") @db.VarChar(50)
  invitedBy String?  @map("invited_by") @db.Uuid
  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @map("joined_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])
  
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

/// Role - RBAC role within a tenant
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isDefault   Boolean  @default(false) @map("is_default")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  memberships Membership[]
  permissions RolePermission[]
  
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Permission - atomic permission (resource + action)
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String?  @db.Text
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  roles RolePermission[]
  
  @@unique([resource, action])
  @@map("permissions")
}

/// RolePermission - many-to-many between Role and Permission
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Session - user session (JWT refresh tokens, etc)
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique @db.Text
  refreshToken String?  @unique @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  
  createdAt    DateTime @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================
// APPLICATIONS
// ============================================================

/// Application - business application
model Application {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  slug        String   @db.VarChar(100)
  status      String   @default("draft") @db.VarChar(50)
  
  currentVersionId String? @map("current_version_id") @db.Uuid
  
  metadata    Json     @default("{}")
  settings    Json     @default("{}")
  tags        String[] @default([])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions    ApplicationVersion[]
  environments Environment[]
  deployments Deployment[]
  
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@map("applications")
}

/// ApplicationVersion - versioned application snapshot
model ApplicationVersion {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  version       String   @db.VarChar(50)
  spec          Json
  changelog     String?  @db.Text
  createdBy     String?  @map("created_by") @db.Uuid
  isCurrent     Boolean  @default(false) @map("is_current")
  
  createdAt     DateTime @default(now()) @map("created_at")
  
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([applicationId, version])
  @@index([applicationId])
  @@index([isCurrent])
  @@map("application_versions")
}

/// Environment - deployment environment for an application
model Environment {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  name          String   @db.VarChar(100)
  type          String   @db.VarChar(50)
  url           String?  @db.Text
  config        Json     @default("{}")
  variables     Json     @default("{}")
  isDefault     Boolean  @default(false) @map("is_default")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([applicationId, name])
  @@index([applicationId])
  @@map("environments")
}

// ============================================================
// WORKFLOWS
// ============================================================

/// Workflow - automation workflow
model Workflow {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  slug        String   @db.VarChar(100)
  status      String   @default("draft") @db.VarChar(50)
  
  currentVersionId String? @map("current_version_id") @db.Uuid
  
  triggers    Json     @default("[]")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions   WorkflowVersion[]
  executions WorkflowExecution[]
  
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@map("workflows")
}

/// WorkflowVersion - versioned workflow definition
model WorkflowVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  version     String   @db.VarChar(50)
  definition  Json
  changelog   String?  @db.Text
  createdBy   String?  @map("created_by") @db.Uuid
  isCurrent   Boolean  @default(false) @map("is_current")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([isCurrent])
  @@map("workflow_versions")
}

/// WorkflowExecution - single workflow execution instance
model WorkflowExecution {
  id           String   @id @default(uuid()) @db.Uuid
  workflowId   String   @map("workflow_id") @db.Uuid
  versionId    String?  @map("version_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  status       String   @default("pending") @db.VarChar(50)
  
  input        Json     @default("{}")
  output       Json     @default("{}")
  variables    Json     @default("{}")
  
  currentStep  String?  @map("current_step") @db.VarChar(100)
  stepResults  Json     @default("[]")
  
  error        String?  @db.Text
  
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  duration     Int?
  retryCount   Int      @default(0) @map("retry_count")
  
  triggeredBy  String?  @map("triggered_by") @db.Uuid
  triggerType  String   @default("manual") @map("trigger_type") @db.VarChar(50)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  @@index([workflowId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_executions")
}

// ============================================================
// DEPLOYMENTS
// ============================================================

/// Deployment - application deployment record
model Deployment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  environmentId String   @map("environment_id") @db.Uuid
  versionId     String?  @map("version_id") @db.Uuid
  
  status        String   @default("pending") @db.VarChar(50)
  platform      String   @db.VarChar(50)
  
  config        Json     @default("{}")
  logs          Json     @default("[]")
  
  healthStatus  String?  @map("health_status") @db.VarChar(50)
  healthChecks  Json     @default("[]")
  
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  duration      Int?
  
  error         String?  @db.Text
  
  triggeredBy   String?  @map("triggered_by") @db.Uuid
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@index([applicationId])
  @@index([tenantId])
  @@index([status])
  @@map("deployments")
}

// ============================================================
// SECRETS
// ============================================================

/// Secret - encrypted secret metadata
model Secret {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  type        String   @db.VarChar(50)
  provider    String?  @db.VarChar(50)
  
  vaultPath   String?  @map("vault_path") @db.Text
  metadata    Json     @default("{}")
  
  rotationEnabled Boolean @default(false) @map("rotation_enabled")
  lastRotatedAt   DateTime? @map("last_rotated_at")
  nextRotationAt  DateTime? @map("next_rotation_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("secrets")
}

// ============================================================
// AUDIT & COMPLIANCE
// ============================================================

/// AuditEvent - comprehensive audit log
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  
  eventType   String   @map("event_type") @db.VarChar(50)
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  resourceId  String?  @map("resource_id") @db.Uuid
  
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  sessionId   String?  @map("session_id") @db.Uuid
  requestId   String?  @map("request_id") @db.VarChar(100)
  
  details     Json     @default("{}")
  status      String   @default("success") @db.VarChar(50)
  errorMessage String? @map("error_message") @db.Text
  
  duration    Int?
  
  timestamp   DateTime @default(now())
  
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([tenantId, timestamp])
  @@index([userId, timestamp])
  @@index([eventType, timestamp])
  @@index([resource, resourceId])
  @@map("audit_events")
}

/// ActivityLog - user activity stream
model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  resourceId  String?  @map("resource_id") @db.Uuid
  details     Json     @default("{}")
  
  timestamp   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, timestamp])
  @@index([userId, timestamp])
  @@map("activity_logs")
}

// ============================================================
// USAGE & COST
// ============================================================

/// UsageRecord - usage tracking for billing
model UsageRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  
  service     String   @db.VarChar(50)
  operation   String   @db.VarChar(100)
  quantity    Float
  unit        String   @db.VarChar(50)
  
  model       String?  @db.VarChar(100)
  provider    String?  @db.VarChar(50)
  
  metadata    Json     @default("{}")
  
  timestamp   DateTime @default(now())
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costRecords CostRecord[]
  
  @@index([tenantId, timestamp])
  @@index([service, timestamp])
  @@map("usage_records")
}

/// CostRecord - cost calculation
model CostRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  usageRecordId String?  @map("usage_record_id") @db.Uuid
  
  service       String   @db.VarChar(50)
  description   String   @db.Text
  
  quantity      Float
  unitCost      Float    @map("unit_cost")
  totalCost     Float    @map("total_cost")
  currency      String   @default("USD") @db.VarChar(3)
  
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  
  timestamp     DateTime @default(now())
  
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageRecord UsageRecord? @relation(fields: [usageRecordId], references: [id], onDelete: SetNull)
  
  @@index([tenantId, timestamp])
  @@index([periodStart, periodEnd])
  @@map("cost_records")
}

/// Budget - spending limit per tenant
model Budget {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(255)
  service         String   @db.VarChar(50)
  period          String   @db.VarChar(20)
  limit           Float
  current         Float    @default(0)
  alertThresholds Json     @default("[50, 80, 100]") @map("alert_thresholds")
  alertsSent      Json     @default("[]") @map("alerts_sent")
  autoActions     Json     @default("{}") @map("auto_actions")
  status          String   @default("active") @db.VarChar(50)
  resetAt         DateTime @map("reset_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([status])
  @@map("budgets")
}

// ============================================================
// MARKETPLACE
// ============================================================

/// MarketplaceTemplate - Published template
model MarketplaceTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  slug            String   @unique @db.VarChar(100)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  longDescription String?  @map("long_description") @db.Text
  category        String   @db.VarChar(50)
  tags            String[] @default([])
  icon            String?  @db.VarChar(500)
  screenshots     String[] @default([])
  
  currentVersionId String? @map("current_version_id") @db.Uuid
  
  status          String   @default("draft") @db.VarChar(50)
  visibility      String   @default("public") @db.VarChar(50)
  
  priceType       String   @default("free") @db.VarChar(20)
  priceAmount     Float?   @map("price_amount")
  currency        String   @default("USD") @db.VarChar(3)
  
  installCount    Int      @default(0) @map("install_count")
  viewCount       Int      @default(0) @map("view_count")
  downloadCount   Int      @default(0) @map("download_count")
  rating          Float    @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  trendingScore   Float    @default(0) @map("trending_score")
  
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedBy      String?  @map("reviewed_by") @db.Uuid
  reviewNotes     String?  @map("review_notes") @db.Text
  
  license         String   @default("MIT") @db.VarChar(50)
  documentation   String?  @db.Text
  repositoryUrl   String?  @map("repository_url") @db.Text
  demoUrl         String?  @map("demo_url") @db.Text
  supportUrl      String?  @map("support_url") @db.Text
  minPlatformVersion String? @map("min_platform_version") @db.VarChar(50)
  
  metadata        Json     @default("{}")
  
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  
  author       MarketplaceAuthor    @relation(fields: [authorId], references: [id])
  versions     MarketplaceVersion[]
  reviews      MarketplaceReview[]
  purchases    MarketplacePurchase[]
  installs     MarketplaceInstall[]
  
  @@index([status, visibility])
  @@index([category])
  @@index([authorId])
  @@index([trendingScore])
  @@index([priceType])
  @@map("marketplace_templates")
}

/// MarketplaceVersion - Versioned template content
model MarketplaceVersion {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  version       String   @db.VarChar(50)
  changelog     String?  @db.Text
  spec          Json
  size          Int      @default(0)
  checksum      String   @db.VarChar(64)
  isCurrent     Boolean  @default(false) @map("is_current")
  isBreaking    Boolean  @default(false) @map("is_breaking")
  minPlatformVersion String? @map("min_platform_version") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  
  template MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  @@unique([templateId, version])
  @@index([templateId])
  @@index([isCurrent])
  @@map("marketplace_versions")
}

/// MarketplaceAuthor - Creator profile & earnings
model MarketplaceAuthor {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  displayName       String   @map("display_name") @db.VarChar(100)
  bio               String?  @db.Text
  avatarUrl         String?  @map("avatar_url") @db.Text
  websiteUrl        String?  @map("website_url") @db.Text
  twitterHandle     String?  @map("twitter_handle") @db.VarChar(50)
  githubHandle      String?  @map("github_handle") @db.VarChar(50)
  
  verified          Boolean  @default(false)
  verifiedAt        DateTime? @map("verified_at")
  verificationNotes String?  @map("verification_notes") @db.Text
  
  totalEarnings     Float    @default(0) @map("total_earnings")
  availableBalance  Float    @default(0) @map("available_balance")
  pendingBalance    Float    @default(0) @map("pending_balance")
  totalPaidOut      Float    @default(0) @map("total_paid_out")
  currency          String   @default("USD") @db.VarChar(3)
  
  stripeAccountId   String?  @map("stripe_account_id") @db.VarChar(100)
  payoutEnabled     Boolean  @default(false) @map("payout_enabled")
  
  templateCount     Int      @default(0) @map("template_count")
  installCount      Int      @default(0) @map("install_count")
  averageRating     Float    @default(0) @map("average_rating")
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  templates  MarketplaceTemplate[]
  payouts    MarketplacePayout[]
  
  @@index([verified])
  @@map("marketplace_authors")
}

/// MarketplacePurchase - Payment record
model MarketplacePurchase {
  id              String   @id @default(uuid()) @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  buyerId         String   @map("buyer_id") @db.Uuid
  buyerTenantId   String   @map("buyer_tenant_id") @db.Uuid
  
  amount          Float
  currency        String   @default("USD") @db.VarChar(3)
  platformFee     Float    @map("platform_fee")
  authorEarnings  Float    @map("author_earnings")
  
  status          String   @default("pending") @db.VarChar(50)
  paymentProvider String?  @map("payment_provider") @db.VarChar(50)
  paymentIntentId String?  @map("payment_intent_id") @db.VarChar(200)
  
  refundedAt      DateTime? @map("refunded_at")
  refundReason    String?  @map("refund_reason") @db.Text
  
  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  
  template MarketplaceTemplate @relation(fields: [templateId], references: [id])
  
  @@index([templateId])
  @@index([buyerId])
  @@index([status])
  @@map("marketplace_purchases")
}

/// MarketplaceInstall - Install record
model MarketplaceInstall {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  versionId     String?  @map("version_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  
  status        String   @default("pending") @db.VarChar(50)
  error         String?  @db.Text
  
  createdAt     DateTime @default(now()) @map("created_at")
  installedAt   DateTime? @map("installed_at")
  
  template MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([templateId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("marketplace_installs")
}

/// MarketplaceReview - User rating & review
model MarketplaceReview {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  rating      Int
  title       String?  @db.VarChar(200)
  comment     String?  @db.Text
  
  status      String   @default("published") @db.VarChar(50)
  helpful     Int      @default(0)
  reported    Int      @default(0)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  template MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([templateId, userId])
  @@index([templateId])
  @@index([status])
  @@map("marketplace_reviews")
}

/// MarketplacePayout - Creator payout record
model MarketplacePayout {
  id              String   @id @default(uuid()) @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  amount          Float
  currency        String   @default("USD") @db.VarChar(3)
  
  status          String   @default("pending") @db.VarChar(50)
  provider        String   @default("stripe") @db.VarChar(50)
  providerRef     String?  @map("provider_ref") @db.VarChar(200)
  
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  
  notes           String?  @db.Text
  error           String?  @db.Text
  
  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  
  author MarketplaceAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@index([authorId])
  @@index([status])
  @@map("marketplace_payouts")
}

// ============================================================
// AI AGENTS
// ============================================================

/// Agent - Autonomous business logic agent
model Agent {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String   @db.VarChar(255)
  description        String   @db.Text
  icon               String?  @db.VarChar(50)
  category           String   @default("custom") @db.VarChar(50)
  
  systemPrompt       String   @map("system_prompt") @db.Text
  model              String   @default("gpt-4-turbo-preview") @db.VarChar(100)
  temperature        Float    @default(0.3)
  maxSteps           Int      @default(20) @map("max_steps")
  maxTokensPerRun    Int      @default(100000) @map("max_tokens_per_run")
  maxDurationSeconds Int      @default(300) @map("max_duration_seconds")
  
  allowedTools       String[] @default([]) @map("allowed_tools")
  capabilities       Json     @default("[]")
  
  requiresApproval   Boolean  @default(true) @map("requires_approval")
  approvalThreshold  String   @default("high") @map("approval_threshold") @db.VarChar(20)
  
  triggers           Json     @default("[]")
  
  status             String   @default("active") @db.VarChar(50)
  
  createdBy          String?  @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  
  runs AgentRun[]
  
  @@index([tenantId])
  @@index([status])
  @@map("agents")
}

/// AgentRun - single agent execution
model AgentRun {
  id                 String   @id @default(uuid()) @db.Uuid
  agentId            String   @map("agent_id") @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  
  status             String   @default("pending") @db.VarChar(50)
  input              Json     @default("{}")
  output             Json?
  error              String?  @db.Text
  
  currentStepIndex   Int      @default(0) @map("current_step_index")
  totalTokens        Int      @default(0) @map("total_tokens")
  totalCostUsd       Float    @default(0) @map("total_cost_usd")
  toolCalls          Int      @default(0) @map("tool_calls")
  
  startedAt          DateTime @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  durationMs         Int?     @map("duration_ms")
  
  approvalRequestId  String?  @map("approval_request_id") @db.Uuid
  metadata           Json     @default("{}")
  
  agent Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  steps AgentStep[]
  
  @@index([agentId])
  @@index([tenantId])
  @@index([status])
  @@map("agent_runs")
}

/// AgentStep - individual step in an agent run
model AgentStep {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  stepIndex   Int      @map("step_index")
  type        String   @db.VarChar(50)
  
  thought     String?  @db.Text
  action      Json?
  observation Json?
  decision    Json?
  output      String?  @db.Text
  approval    Json?
  
  tokensUsed  Int      @default(0) @map("tokens_used")
  costUsd     Float    @default(0) @map("cost_usd")
  durationMs  Int      @default(0) @map("duration_ms")
  error       String?  @db.Text
  
  timestamp   DateTime @default(now())
  
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  
  @@index([runId])
  @@map("agent_steps")
}

// ============================================================
// ANALYTICS
// ============================================================

/// MetricDataPoint - time-series metric
model MetricDataPoint {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  metricName  String   @map("metric_name") @db.VarChar(100)
  value       Float
  labels      Json     @default("{}")
  timestamp   DateTime @default(now())
  
  @@index([tenantId, metricName, timestamp])
  @@map("metric_data_points")
}

/// KPI - Key Performance Indicator definition
model KPI {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  unit            String   @db.VarChar(50)
  category        String   @db.VarChar(50)
  targetValue     Float    @map("target_value")
  targetDirection String   @map("target_direction") @db.VarChar(20)
  targetPeriod    String   @map("target_period") @db.VarChar(20)
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  values KPIValue[]
  
  @@index([tenantId])
  @@map("kpis")
}

/// KPIValue - KPI value over time
model KPIValue {
  id             String   @id @default(uuid()) @db.Uuid
  kpiId          String   @map("kpi_id") @db.Uuid
  value          Float
  status         String   @db.VarChar(20)
  trend          String   @db.VarChar(20)
  percentChange  Float    @default(0) @map("percent_change")
  timestamp      DateTime @default(now())
  
  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  
  @@index([kpiId, timestamp])
  @@map("kpi_values")
}

/// Funnel - Conversion funnel definition
model Funnel {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  steps       Json
  windowHours Int      @default(24) @map("window_hours")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([tenantId])
  @@map("funnels")
}

/// AnalyticsEvent - user/business analytics event
model AnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.VarChar(100)
  eventName   String   @map("event_name") @db.VarChar(100)
  properties  Json     @default("{}")
  timestamp   DateTime @default(now())
  
  @@index([tenantId, eventName, timestamp])
  @@index([tenantId, userId, timestamp])
  @@map("analytics_events")
}

// ============================================================
// ENTERPRISE INTEGRATIONS
// ============================================================

/// IntegrationConnection - Connected external integration
model IntegrationConnection {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  integrationType       String    @map("integration_type") @db.VarChar(50)
  name                  String    @db.VarChar(255)
  status                String    @default("connected") @db.VarChar(50)
  accessTokenEncrypted  String?   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?   @map("refresh_token_encrypted") @db.Text
  expiresAt             DateTime? @map("expires_at")
  scopes                String[]  @default([])
  config                Json      @default("{}")
  connectedBy           String    @map("connected_by") @db.Uuid
  connectedAt           DateTime  @default(now()) @map("connected_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  lastUsedAt            DateTime? @map("last_used_at")
  lastError             String?   @map("last_error") @db.Text
  
  @@index([tenantId])
  @@index([integrationType])
  @@map("integration_connections")
}

/// OAuthState - PKCE state for OAuth2 flows
model OAuthState {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  integrationType String   @map("integration_type") @db.VarChar(50)
  state           String   @unique @db.VarChar(100)
  codeVerifier    String   @map("code_verifier") @db.VarChar(100)
  redirectUri     String   @map("redirect_uri") @db.Text
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@index([state])
  @@map("oauth_states")
}

// ============================================================
// COMPLIANCE
// ============================================================

/// ComplianceFramework - Compliance framework metadata
model ComplianceFramework {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100) @unique
  version     String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  
  controls ComplianceControl[]
  
  @@map("compliance_frameworks")
}

/// ComplianceControl - Individual control in a framework
model ComplianceControl {
  id          String   @id @default(uuid()) @db.Uuid
  frameworkId String   @map("framework_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  
  framework ComplianceFramework  @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  evidence  ComplianceEvidence[]
  
  @@unique([frameworkId, code])
  @@map("compliance_controls")
}

/// ComplianceEvidence - Evidence for control compliance
model ComplianceEvidence {
  id          String    @id @default(uuid()) @db.Uuid
  controlId   String    @map("control_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  status      String    @db.VarChar(50)
  type        String    @db.VarChar(50)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  url         String?   @db.Text
  assessedBy  String?   @map("assessed_by") @db.Uuid
  assessedAt  DateTime? @map("assessed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  control ComplianceControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([controlId])
  @@map("compliance_evidence")
}
